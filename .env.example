# GUI VLM
VLM_PROVIDER=
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL_NAME=

# Voice engine: cascade is the UI-tars ASR + LLM + TTS path.
CYRVIS_VOICE_ENGINE=cascade
VOICE_ENABLED=true
VOICE_REQUIRE_WAKE_WORD=true
VOICE_WAKE_WORD=XiaoT
VOICE_LANGUAGE=zh
VOICE_SILENCE_TIMEOUT_MS=600
# Near-real-time Windows process/window observation. Set to 0 to disable.
CYRVIS_RUNTIME_MONITOR=1
CYRVIS_RUNTIME_MONITOR_INTERVAL_MS=500
CYRVIS_FILE_PERCEPTION=1
CYRVIS_FILE_PERCEPTION_MS=2000
# Optional semicolon-separated watched roots. Defaults to Desktop/Downloads/Documents/cwd.
# CYRVIS_FILE_PERCEPTION_ROOTS=D:\work;E:\assets
CYRVIS_MAX_CONCURRENT_TASKS=4
CYRVIS_MAX_INTERACTIVE_TASKS=2
CYRVIS_MAX_NORMAL_TASKS=4
CYRVIS_MAX_BACKGROUND_TASKS=1
CYRVIS_TASK_IDEMPOTENCY_TTL_MS=86400000
CYRVIS_CLIPBOARD_PERCEPTION=1
CYRVIS_CLIPBOARD_PERCEPTION_MS=1500
CYRVIS_CLIPBOARD_CONTENT=0
CYRVIS_UI_FOCUS_PERCEPTION=1
CYRVIS_UI_FOCUS_PERCEPTION_MS=1500
CYRVIS_SELECTED_TEXT_PERCEPTION=1
CYRVIS_AUTONOMY_MODE=suggest
# CYRVIS_AUTONOMY_QUIET_START=22:00
# CYRVIS_AUTONOMY_QUIET_END=08:00
CYRVIS_CAPABILITY_SYNTHESIS_MS=600000
# CYRVIS_CAPABILITY_MODEL=qwen-plus

# Conversation LLM (OpenAI-compatible)
CONVERSATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CONVERSATION_API_KEY=
CONVERSATION_MODEL_NAME=qwen-plus

# Streaming ASR: qwen-dashscope-streaming, openai-compatible, or tenlai-async.
VOICE_STT_PROVIDER=qwen-dashscope-streaming
VOICE_STT_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
VOICE_STT_API_KEY=
VOICE_STT_MODEL=qwen-audio-3.1-asr-flash-streaming

# Local Breeze TTS is the default TTS path.
VOICE_TTS_ENABLED=true
VOICE_TTS_PROVIDER=breeze-local
VOICE_TTS_BASE_URL=http://127.0.0.1:8137/v1
VOICE_TTS_MODEL=breeze-tts-2
VOICE_TTS_INSTRUCTION=clear natural Chinese female voice
VOICE_TTS_CFG_SCALE=1
VOICE_TTS_SEED=42
# BREEZE_TTS_RUNTIME_DIR=
# BREEZE_TTS_MODEL_PATH=

# Qwen cloud TTS. Select VOICE_TTS_PROVIDER=qwen-tts-realtime to use it.
VOICE_QWEN_TTS_API_KEY=
VOICE_QWEN_TTS_MODEL=qwen3-tts-flash-realtime
VOICE_QWEN_TTS_VOICE=Cherry
# For voice cloning use qwen-audio-3.1-tts-flash and either a Voice ID or:
# VOICE_QWEN_TTS_REFERENCE_AUDIO_PATH=D:\voices\reference.wav
# VOICE_QWEN_TTS_PREFERRED_NAME=cyrvis

# Optional remote document-generation fallback. The endpoint must return a
# native .pptx binary for POST JSON {format,filename,title,subtitle}.
# CYRVIS_DOCUMENT_API_URL=https://example.com/v1/presentations
# CYRVIS_DOCUMENT_API_KEY=

# Qwen-Doc-Turbo PPT generation (Bailian, cn-beijing).
# Use a workspace-specific endpoint when required by your Bailian account.
CYRVIS_QWEN_DOC_API_KEY=
CYRVIS_QWEN_DOC_WORKSPACE_ID=
# CYRVIS_QWEN_DOC_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CYRVIS_QWEN_DOC_MODEL=qwen-doc-turbo
CYRVIS_QWEN_DOC_TIMEOUT_MS=600000
